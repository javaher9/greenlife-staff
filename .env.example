DEBUG=0
SECRET_KEY=replace-with-a-long-random-value-generated-on-the-server
ALLOWED_HOSTS=staff.greenlifeclinics.com,report.greenlifeclinics.com,localhost,127.0.0.1,192.168.40.96
CSRF_TRUSTED_ORIGINS=https://staff.greenlifeclinics.com,https://report.greenlifeclinics.com

POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-database-password
POSTGRES_HOST=192.168.40.96
POSTGRES_PORT=5432

# Keep the current published port unchanged.
NGINX_PORT=8085
HEALTHCHECK_URL=http://127.0.0.1:8085/api/health/
GUNICORN_WORKERS=3
BACKUP_RETENTION_DAYS=14

OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_ANALYSIS_MODEL=gpt-4.1-mini

# Production security. Only change DISABLE_CSRF temporarily for isolated local-IP troubleshooting.
DISABLE_CSRF=0
CSRF_COOKIE_SECURE=1
SESSION_COOKIE_SECURE=1

# Read-only reporting/integration API. Generate a long random value on the server.
STAFF_REPORT_API_KEY=
# Optional separate MCP key. When blank, MCP securely reuses STAFF_REPORT_API_KEY.
MCP_API_KEY=

# Greenlife shared API (SMS + CRM) is configured by an administrator inside
# Staff App at /settings/api/. X-API-Key is encrypted in the database and must
# never be committed to this file or source control.

# Staff scoring / alerts
REPORT_MISSING_PENALTY=-2
ON_TIME_POINTS=5
REPORT_POINTS=3
TASK_POINTS=4
BRANCH_REVENUE_TARGET_DAILY=0
